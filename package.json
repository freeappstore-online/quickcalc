{
  "name": "quickcalc",
  "description": "Everyday calculators: tip & split, percent, discount, age & date, fuel. Private and offline.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/quickcalc.git"
  },
  "scripts": {
    "dev": "pnpm --filter @quickcalc/web dev",
    "build": "pnpm --filter @quickcalc/web build",
    "preview": "pnpm --filter @quickcalc/web preview",
    "typecheck": "pnpm --filter @quickcalc/web exec tsc -b && tsc -p e2e",
    "test": "pnpm --filter @quickcalc/web test",
    "e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "1.64.1",
    "typescript": "~6.0.3"
  }
}
